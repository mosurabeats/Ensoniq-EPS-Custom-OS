@@ -452,6 +452,47 @@ void esqpanel_device::device_start()
 		m_external_timer = timer_alloc(FUNC(esqpanel_device::check_external_panel_server), this);
 		m_external_timer->enable(false);
 	}
+
+	// EPS custom OS project: ESQPANEL_KEYS names a file of lines
+	// "SECONDS HEX [HEX...]": at that emulated time the panel sends those
+	// bytes to the CPU, as if keys or buttons were pressed. '#' starts a comment.
+	m_script_timer = timer_alloc(FUNC(esqpanel_device::send_scripted_keys), this);
+	if (const char *path = getenv("ESQPANEL_KEYS"))
+	{
+		FILE *f = fopen(path, "r");
+		char line[256];
+		while (f && fgets(line, sizeof(line), f))
+		{
+			if (char *hash = strchr(line, '#'))
+				*hash = 0;
+			std::istringstream in(line);
+			double t;
+			if (!(in >> t))
+				continue;
+			std::vector<uint8_t> bytes;
+			std::string tok;
+			while (in >> tok)
+				bytes.push_back(uint8_t(std::stoul(tok, nullptr, 16)));
+			m_script.emplace_back(t, bytes);
+		}
+		if (f)
+			fclose(f);
+		std::stable_sort(m_script.begin(), m_script.end(),
+				[] (const auto &a, const auto &b) { return a.first < b.first; });
+	}
+}
+
+TIMER_CALLBACK_MEMBER(esqpanel_device::send_scripted_keys)
+{
+	const double now = machine().time().as_double();
+	while (m_script_pos < m_script.size() && m_script[m_script_pos].first <= now + 1e-9)
+	{
+		for (uint8_t b : m_script[m_script_pos].second)
+			xmit_char(b);
+		m_script_pos++;
+	}
+	if (m_script_pos < m_script.size())
+		m_script_timer->adjust(attotime::from_double(m_script[m_script_pos].first - now));
 }
 
 
